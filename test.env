# test config — points cheat.py at the local mock (mock_spada.py).
# Run with:  $env:CHEAT_ENV_FILE = "test.env"; python cheat.py
# Nothing here is real; the mock accepts any credentials.

BASE_URL=http://127.0.0.1:8765/v1
MODEL=mock-quiz-model
BYNARA_API_KEY=test-key-not-real

SPADA_USERNAME=testuser
PASSWORD=testpass

# start the mock with --modal and/or --password to exercise those paths
QUIZ_URL=http://127.0.0.1:8765/mod/quiz/view.php?id=42
QUIZ_PASSWORD=opensesame

# browser user agent (spoofing Safe Exam Browser)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/147.0.7727.118 SEB/3.10.2 (x64)
